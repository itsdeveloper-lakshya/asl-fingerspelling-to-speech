// --- PREMIUM THREE.JS & INTERACTIVE ENGINE --- //

const frostLayer = document.querySelector('.frost-layer');
const board = document.querySelector('.premium-card');
const cursorDot = document.querySelector('.cursor-dot');
const cursorOutline = document.querySelector('.cursor-outline');
const interactiveEls = document.querySelectorAll('.interactive-el');

let mouseX = window.innerWidth / 2;
let mouseY = window.innerHeight / 2;
let outlineX = mouseX;
let outlineY = mouseY;
let smoothMaskX = mouseX;
let smoothMaskY = mouseY;

// For Three.JS specifically (normalized coordinates)
let tMouseX = 0; 
let tMouseY = 0;

window.addEventListener('mousemove', (e) => {
  mouseX = e.clientX;
  mouseY = e.clientY;
  
  // Normalize mouse for 3D orbit (-1 to +1)
  tMouseX = (e.clientX / window.innerWidth) * 2 - 1;
  tMouseY = -(e.clientY / window.innerHeight) * 2 + 1;
});

// Cinematic Boot
if(board) {
  gsap.to(board, { opacity: 1, y: 0, duration: 1.2, ease: "power4.out", delay: 0.2 });
}

// ==========================================
// 1. THREE.JS HOLOGRAPHIC SENSOR CORE
// ==========================================
const container = document.getElementById('webgl-container');
let scene, camera, renderer, holoMesh, particles;

function initThreeJS() {
  if(!container || typeof THREE === 'undefined') return;

  scene = new THREE.Scene();
  
  camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 1000);
  camera.position.z = 10;

  renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
  renderer.setSize(container.clientWidth, container.clientHeight);
  renderer.setPixelRatio(window.devicePixelRatio);
  // Add canvas directly to the container but absolute positioned
  renderer.domElement.style.position = 'absolute';
  renderer.domElement.style.top = '0';
  renderer.domElement.style.left = '0';
  renderer.domElement.style.pointerEvents = 'none';
  renderer.domElement.style.mixBlendMode = 'screen';
  container.appendChild(renderer.domElement);

  // Hologram Core (Icosahedron Wireframe)
  const geometry = new THREE.IcosahedronGeometry(2, 1);
  const material = new THREE.MeshBasicMaterial({ 
    color: 0x00ffff, 
    wireframe: true,
    transparent: true,
    opacity: 0.3
  });
  holoMesh = new THREE.Mesh(geometry, material);
  scene.add(holoMesh);

  // Inner Core (Solid glowing sphere)
  const innerGeo = new THREE.SphereGeometry(1.2, 32, 32);
  const innerGeoMat = new THREE.MeshBasicMaterial({ color: 0x0099ff, transparent: true, opacity: 0.1 });
  const innerMesh = new THREE.Mesh(innerGeo, innerGeoMat);
  holoMesh.add(innerMesh);

  // Floating Data Particles
  const particleCount = 100;
  const pGeometry = new THREE.BufferGeometry();
  const pPos = new Float32Array(particleCount * 3);
  for(let i=0; i < particleCount * 3; i++){
    pPos[i] = (Math.random() - 0.5) * 15;
  }
  pGeometry.setAttribute('position', new THREE.BufferAttribute(pPos, 3));
  const pMaterial = new THREE.PointsMaterial({
    color: 0xffffff, size: 0.05, transparent: true, opacity: 0.6
  });
  particles = new THREE.Points(pGeometry, pMaterial);
  scene.add(particles);

  // Resize handler specifically for module
  window.addEventListener('resize', () => {
    if(container.clientWidth > 0) {
      camera.aspect = container.clientWidth / container.clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(container.clientWidth, container.clientHeight);
    }
  });

  animateThreeJS();
}

function animateThreeJS() {
  requestAnimationFrame(animateThreeJS);

  // Core spinning and drifting
  holoMesh.rotation.x += 0.005;
  holoMesh.rotation.y += 0.008;

  particles.rotation.y -= 0.002;

  // Track Mouse in 3D parallax
  const targetX = tMouseX * 3;
  const targetY = tMouseY * 3;
  
  holoMesh.position.x += (targetX - holoMesh.position.x) * 0.05;
  holoMesh.position.y += (targetY - holoMesh.position.y) * 0.05;

  camera.position.x += (tMouseX * 1 - camera.position.x) * 0.1;
  camera.position.y += (tMouseY * 1 - camera.position.y) * 0.1;
  camera.lookAt(scene.position);

  renderer.render(scene, camera);
}
initThreeJS();


// ==========================================
// 2. HIGH-END UI INTERACTION LOOP
// ==========================================
function animateEngine() {
  // Smooth Outline Cursor Math
  const dx = mouseX - outlineX;
  const dy = mouseY - outlineY;
  outlineX += dx * 0.2;
  outlineY += dy * 0.2;
  
  // Smooth Frost Lens Math
  smoothMaskX += (mouseX - smoothMaskX) * 0.1;
  smoothMaskY += (mouseY - smoothMaskY) * 0.1;

  // Apply Cursor Transforms
  if(cursorDot) cursorDot.style.transform = `translate(${mouseX - 3}px, ${mouseY - 3}px)`;
  if(cursorOutline) cursorOutline.style.transform = `translate(${outlineX - 20}px, ${outlineY - 20}px)`;

  // Update Frost Lens Mask
  if(frostLayer) {
    frostLayer.style.setProperty('--mouse-x', `${smoothMaskX}px`);
    frostLayer.style.setProperty('--mouse-y', `${smoothMaskY}px`);
  }

  // Interactive Card Glow Parallax
  if(board) {
    const rect = board.getBoundingClientRect();
    const cardMouseX = mouseX - rect.left;
    const cardMouseY = mouseY - rect.top;
    board.style.setProperty('--card-mouse-x', `${cardMouseX}px`);
    board.style.setProperty('--card-mouse-y', `${cardMouseY}px`);

    const centerX = window.innerWidth / 2;
    const centerY = window.innerHeight / 2;
    const rotateX = ((mouseY - centerY) / centerY) * -3;
    const rotateY = ((mouseX - centerX) / centerX) * 3;
    board.style.transform = `perspective(2000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
  }

  requestAnimationFrame(animateEngine);
}
animateEngine();

// ==========================================
// 3. HOVER PHYSICS & MAGNETIC BUTTONS
// ==========================================
interactiveEls.forEach(el => {
  el.addEventListener('mouseenter', () => {
    document.body.classList.add('hovering');
  });
  
  el.addEventListener('mouseleave', () => {
    document.body.classList.remove('hovering');
    gsap.to(el, { x: 0, y: 0, duration: 0.6, ease: 'elastic.out(1, 0.4)' });
  });

  // Ignore magnetic pull on the Bootstrap dropdown toggle to prevent weird click offsets
  if(!el.classList.contains('dropdown-toggle')) {
    el.addEventListener('mousemove', (e) => {
      const rect = el.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;

      const pull = el.classList.contains('camera-module') ? 0.02 : 0.15;
      gsap.to(el, { x: x * pull, y: y * pull, duration: 0.3, ease: 'power2.out' });
    });
  }
});
